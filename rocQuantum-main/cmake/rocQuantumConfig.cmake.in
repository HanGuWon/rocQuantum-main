@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(rocQuantum_BUILT_WITH_METIS @ROCQUANTUM_BUILT_WITH_METIS@)

find_dependency(hip CONFIG REQUIRED)
find_dependency(hiprand REQUIRED)
find_dependency(rocblas REQUIRED)
find_dependency(rocsolver REQUIRED)
find_package(rccl QUIET)

if(rocQuantum_BUILT_WITH_METIS AND NOT TARGET METIS::METIS)
    find_path(ROCQUANTUM_METIS_INCLUDE_DIR NAMES metis.h)
    find_library(ROCQUANTUM_METIS_LIBRARY NAMES metis)
    if(NOT ROCQUANTUM_METIS_INCLUDE_DIR OR NOT ROCQUANTUM_METIS_LIBRARY)
        set(rocQuantum_FOUND FALSE)
        set(rocQuantum_NOT_FOUND_MESSAGE
            "This rocQuantum package was built with METIS, but METIS headers/library were not found")
        return()
    endif()
    add_library(METIS::METIS UNKNOWN IMPORTED)
    set_target_properties(METIS::METIS PROPERTIES
        IMPORTED_LOCATION "${ROCQUANTUM_METIS_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${ROCQUANTUM_METIS_INCLUDE_DIR}"
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rocQuantumTargets.cmake")
